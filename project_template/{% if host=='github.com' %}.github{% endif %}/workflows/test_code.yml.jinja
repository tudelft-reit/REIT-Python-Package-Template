name: Test Workflow

on:
  push:
    branches:
      - '**'
  pull_request:
    branches:
      - '**'

jobs:
  pytest_commit:
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout code
        uses: actions/checkout@v7

      {% if environment_manager=='pixi' -%}
      - name: Install Pixi
        uses: prefix-dev/setup-pixi@v0.11.3
        with:
          pixi-version: v0.83.0
      {%- elif environment_manager=='uv' -%}
      - name: Install the latest version of uv
        uses: astral-sh/setup-uv@v10.3.3
        with:
          version: latest
      {%- endif %}

      - name: Install the project and its dependencies
        {% if environment_manager=='pixi' -%}
        run: pixi install -e dev
        {%- elif environment_manager=='uv' -%}
        run: uv sync
        {%- endif %}

      - name: Run prek
        {% if environment_manager=='pixi' %}run: pixi run -e dev prek run --all-files
        {%- elif environment_manager=='uv' %}run: uv run prek run --all-files{%- endif %}

      - name: Run Pytest
        {% if environment_manager=='pixi' %}run: pixi run -e dev pytest --cov=src --cov-report term ./tests
        {%- elif environment_manager=='uv' %}run: uv run pytest --cov=src --cov-report term ./tests{%- endif %}
